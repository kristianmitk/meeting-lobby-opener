{
  "manifest_version": 3,
  "name": "Meeting Lobby Opener",
  "version": "0.1.0",
  "description": "Opens the video-call lobby in a new tab when a Google Calendar meeting starts.",
  "permissions": [
    "identity",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting Lobby Opener"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "key": "",
  "commands": {
    "join-meeting": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Join the current or next meeting"
    },
    "new-meeting": {
      "description": "Start an instant Google Meet"
    }
  }
}
